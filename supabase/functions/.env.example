# Local edge-function secrets — copy to `supabase/functions/.env` (git-ignored)
# and use with:  supabase functions serve --env-file supabase/functions/.env
#
# NEVER commit the real values, and NEVER put secret keys in the client
# bundle — these are read only by the server-side edge functions.

# Your OWN Flutterwave TEST secret key (Dashboard → Settings → API keys, Test mode).
FLW_SECRET_KEY=FLWSECK_TEST-your_own_test_key

# Secret hash — pick any random string, set the same one in the Flutterwave
# dashboard (Settings → Webhooks → Secret hash). Used to authenticate incoming
# webhook calls (compared against the `verif-hash` header).
FLW_SECRET_HASH=your-own-random-string

# --- Legacy — only needed if using create-invoice (admin hosted invoicing) ---
# Your OWN Stripe TEST secret key (Dashboard → Developers → API keys, Test mode).
# The generic key shown in Stripe's public docs will NOT work for your account.
STRIPE_SECRET_KEY=sk_test_your_own_test_key

# Webhook signing secret. For local testing, `stripe listen` prints one:
#   stripe listen --forward-to localhost:54321/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
