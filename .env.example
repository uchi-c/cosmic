# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (live authentication + data). When set, the app uses real auth. ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Offline sandbox operator (ONLY used when Supabase is NOT configured) ---
# These drive the local/demo admin login. They are read from the environment at
# build time so NO credentials are hardcoded in the shipped bundle. Leave unset
# to disable offline admin login entirely.
VITE_SANDBOX_ADMIN_EMAIL="operator@example.com"
VITE_SANDBOX_ADMIN_PASSCODE="choose-a-local-only-passcode"

# ============================================================================
# STRIPE (live payments)
# The client needs NO Stripe key — hosted Checkout is created server-side by the
# Supabase edge functions in supabase/functions/. Set these as SUPABASE SECRETS,
# never in the client bundle:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
# Then deploy:  supabase functions deploy create-checkout-session
#               supabase functions deploy stripe-webhook --no-verify-jwt
# See supabase/functions/README.md for the full setup.
# ============================================================================
