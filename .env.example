# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (live authentication + data). When set, the app uses real auth. ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Covert admin entrance (optional) ---
# A secret URL fragment that silently opens the merchant console — the public
# storefront has no visible "sign in" link. Visiting https://yoursite.com/#YOUR_PHRASE
# switches into merchant mode; the fragment is stripped from the URL immediately.
# Pick your own long, unguessable phrase and share it only with your operator/client
# out-of-band (never over an insecure channel). This only hides the entrance — the
# actual gate is still Supabase Auth + the admin_users allowlist. Leave unset to
# disable the hash route (the footer triple-tap still works as a fallback).
VITE_ADMIN_ACCESS_HASH="choose-your-own-long-secret-phrase"

# --- Offline sandbox operator (ONLY used when Supabase is NOT configured) ---
# These drive the local/demo admin login. They are read from the environment at
# build time so NO credentials are hardcoded in the shipped bundle. Leave unset
# to disable offline admin login entirely.
VITE_SANDBOX_ADMIN_EMAIL="operator@example.com"
VITE_SANDBOX_ADMIN_PASSCODE="choose-a-local-only-passcode"

# ============================================================================
# FLUTTERWAVE (live card + mobile money payments)
#
# No client-side key needed — the checkout link is created entirely
# server-side by the create-flutterwave-payment edge function.
#
# Server-side ONLY — set as SUPABASE SECRETS, never in the client bundle:
#   supabase secrets set FLW_SECRET_KEY=FLWSECK-xxx        # Flutterwave dashboard → API keys
#   supabase secrets set FLW_SECRET_HASH=your-own-random-string   # must match the
#     "secret hash" you set in the Flutterwave dashboard → Settings → Webhooks
# Then deploy:  supabase functions deploy create-flutterwave-payment
#               supabase functions deploy flutterwave-webhook --no-verify-jwt
# See supabase/functions/README.md for the full setup.
#
# Why not Stripe: Stripe cannot activate a live merchant account for a
# Zambia-registered business (Zambia isn't on Stripe's supported-country
# list). Flutterwave is licensed to operate with Zambian merchants and
# processes international Visa/Mastercard/Amex + Apple Pay/Google Pay plus
# local mobile money.
#
# The Stripe edge functions (create-payment-intent, create-checkout-session,
# stripe-webhook) are still in the repo but unreached from checkout now.
# create-invoice (admin-generated hosted invoices) still uses Stripe — if you
# want that live too, it needs the same US-entity-style workaround Stripe
# checkout itself would have needed; see the SETUP.md notes.
#   VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"   # only if reviving on-site Stripe
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
# ============================================================================
